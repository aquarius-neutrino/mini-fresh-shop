<view class="login-wrap">
  <view class="title">生鲜商城</view>

  <van-field
    label="手机号"
    value="{{ form.phone }}"
    bind:input="onPhoneInput"
    placeholder="请输入手机号"
    maxlength="11"
  />

  <van-field
    label="密码"
    value="{{ form.pwd }}"
    bind:input="onPwdInput"
    password
    placeholder="请输入密码"
  />

  <van-button type="primary" class="login-btn" bindtap="handleLogin">登录</van-button>
  <van-button plain class="reg-btn" bindtap="handleRegister">注册账号</van-button>
</view>