<!-- 分类横向滚动 -->
<van-button bindtap="toOrder" >我的订单</van-button>
<van-button bindtap="toAddress" style="margin-left:50px;">收货地址</van-button>
<van-button bindtap="toCart" style="margin-left:150px;color:red;">去购物车</van-button>
<scroll-view scroll-x class="category-scroll">
  <view class="category-list">
    <view 
      wx:for="{{categoryList}}" 
      wx:key="id"
      class="category-item {{curCateId === item.id ? 'active' : ''}}"
      bindtap="changeCate"
      data-id="{{item.id}}"
    >
      <image src="{{item.icon}}" class="cate-icon"></image>
      <text>{{item.name}}</text>
    </view>
  </view>
</scroll-view>
<!-- 商品列表 -->
<scroll-view 
  scroll-y 
  class="goods-wrap"
  bindscrolltolower="loadMore"
  refresher-enabled
  bindrefresherrefresh="onRefresh"
  refresher-triggered="{{refreshing}}"
>
  <view wx:if="{{goodsList.length === 0}}">暂无商品</view>
  <view wx:else>
    <block wx:for="{{goodsList}}" wx:key="id">
      <GoodsCard item="{{item}}" bindaddcart="handleAddCart"/>
    </block>
  </view>
  <view class="load-tip" wx:if="{{goodsList.length > 0}}">
    <text wx:if="{{hasMore}}">上拉加载更多</text>
    <text wx:else>没有更多商品了</text>
  </view>
</scroll-view>