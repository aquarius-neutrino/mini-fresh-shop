.category-scroll {
  height: 160rpx;
  background: #fff;
}
.category-list {
  display: flex;
  padding: 20rpx;
  gap: 20rpx;
}
.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
}
.cate-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-bottom: 10rpx;
}
.category-item.active text {
  color: #ee0a24;
  font-weight: bold;
}
.goods-wrap {
  padding: 20rpx;
  height: calc(100vh - 160rpx);
}
.load-tip {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 26rpx;
}