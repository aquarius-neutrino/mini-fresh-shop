<view wx:if="{{ addressList.length === 0 }}" class="empty">
  <text>暂无收货地址</text>
</view>
<van-cell-group wx:else>
  <van-cell wx:for="{{ addressList }}" wx:key="id" data-id="{{item.id}}">
    <view slot="title">{{item.name}} {{item.phone}}</view>
    <view slot="label">
      {{item.province}}{{item.city}}{{item.district}}{{item.detail}}
      <text wx:if="{{item.isDefault}}" class="default-tag">默认</text>
    </view>
    <view slot="right-icon" bindtap="showOperate" data-id="{{item.id}}">···</view>
  </van-cell>
</van-cell-group>

<van-button type="primary" bindtap="toAdd" class="add-btn">新增收货地址</van-button>
<!-- 点击右侧三点触发底部弹窗容器 -->
<!-- 移除van-popup，直接使用van-action-sheet -->
<van-action-sheet 
  show="{{ showSheet }}"
  actions="{{ actionList }}" 
  bind:select="onSheetSelect" 
  bind:close="closeSheet"
  bind:cancel="closeSheet"
  cancel-text="取消" 
/>