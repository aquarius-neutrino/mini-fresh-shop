<van-field label="姓名" value="{{form.name}}" bind:change="onChange" data-key="name" placeholder="请输入姓名" />
<van-field label="手机号" value="{{form.phone}}" bind:change="onChange" data-key="phone" placeholder="请输入手机号" />
<picker mode="region" bindchange="onRegionChange" value="{{regionArr}}">
  <van-field 
    label="省市区" 
    value="{{regionText}}" 
    placeholder="请选择省市区" 
    readonly 
    is-link
  />
</picker>
<van-field label="详细地址" value="{{form.detail}}" bind:change="onChange" data-key="detail" placeholder="街道、门牌号" />

<view class="switch-row">
  <text>设为默认地址</text>
  <van-switch checked="{{form.isDefault}}" bind:change="onSwitchChange" />
</view>

<van-button type="primary" bindtap="submit" class="submit-btn">保存</van-button>