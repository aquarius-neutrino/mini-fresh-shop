}
.goods-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
}
.info {
  display: flex;
  flex-direction: column;
}
.info-group {
  margin-top: 20rpx;
}
.price-red {
  color: #ee0a24;
  font-weight: bold;
}