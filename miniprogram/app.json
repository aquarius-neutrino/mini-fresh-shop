{
  "pages": [
    "pages/index/index",     
    "pages/dummy/dummy",
    "pages/login/index"
  ],
  "subPackages": [
    {
      "root": "subPackages/cart",
      "pages": ["index"]
    },
    {
      "root": "subPackages/address",
      "pages": ["list", "edit"]
    },
    {
      "root": "subPackages/checkout",
      "pages": ["index"]
    },
    {
      "root": "subPackages/order",
      "pages": ["list", "detail"]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "wifi",
      "packages": ["subPackages/cart"]
    }
  },
  "lazyCodeLoading": "requiredComponents",
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#fff",
    "navigationBarTitleText": "生鲜团购商城",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#f5f5f5"
  },
  "tabBar": {
    "custom": true,
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/dummy/dummy",
        "text": "占位"
      }
    ]
  }
}