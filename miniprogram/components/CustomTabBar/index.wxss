.tabbar-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100rpx;
  background: #fff;
  display: flex;
  border-top: 1rpx solid #eee;
  z-index: 998;
  padding-bottom: env(safe-area-inset-bottom);
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.tab-icon {
  font-size: 32rpx;
  margin-bottom: 6rpx;
  color: #999;
}
.tab-text {
  font-size: 22rpx;
  color: #999;
}
.tab-icon.active,
.tab-text.active {
  color: #ee0a24;
}
