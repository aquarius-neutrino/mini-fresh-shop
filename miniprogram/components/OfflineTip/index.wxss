.offline-wrap {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fff;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 999;
}
.offline-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
}
